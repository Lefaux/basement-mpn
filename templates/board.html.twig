{% extends 'base.html.twig' %}
{% block body %}<header><a href="{{ path('board') }}" class="brand active">Music overview</a><nav><a href="{{ path('missing_previews') }}">Missing Previews</a><a href="{{ path('missing_landr') }}">Missing LANDR</a><a href="{{ path('missing_master') }}">Missing Master</a><a href="{{ path('inconsistencies') }}">Inconsistencies <b>{{ inconsistentCount }}</b></a></nav><form method="post" action="{{ path('logout') }}"><button class="link">Log out</button></form></header><main><div class="toolbar"><form method="get">{% for fileFilter in fileFilters %}<input type="hidden" name="file_filter[]" value="{{ fileFilter }}">{% endfor %}<label>Artist <select name="artist" onchange="this.form.submit()"><option value="">All artists</option>{% for option in artists %}<option value="{{ option }}" {{ artist == option ? 'selected' }}>{{ option }} ({{ artistCounts[option] }})</option>{% endfor %}</select></label></form><div class="main-filters"><button type="button" data-main-filter="preview" {{ 'preview' in fileFilters ? 'class="active"' }}>Has Preview <b>{{ mainFilterCounts.preview }}</b></button><button type="button" data-main-filter="render" {{ 'render' in fileFilters ? 'class="active"' }}>Has Render <b>{{ mainFilterCounts.render }}</b></button><button type="button" data-main-filter="landr" {{ 'landr' in fileFilters ? 'class="active"' }}>Has LANDR <b>{{ mainFilterCounts.landr }}</b></button><button type="button" data-main-filter="missing-preview" {{ 'missing-preview' in fileFilters ? 'class="active"' }}>Missing Preview <b>{{ mainFilterCounts['missing-preview'] }}</b></button><button type="button" data-main-filter="missing-render" {{ 'missing-render' in fileFilters ? 'class="active"' }}>Missing Render <b>{{ mainFilterCounts['missing-render'] }}</b></button><button type="button" data-main-filter="missing-landr" {{ 'missing-landr' in fileFilters ? 'class="active"' }}>Missing LANDR <b>{{ mainFilterCounts['missing-landr'] }}</b></button></div></div><section class="board">{% for key, tracks in columns %}<div class="column"><h2>{{ {'idea':'Idea','arrangement':'Arrangement','mastered':'Mastered','final':'Final','release':'Prepped for Release'}[key] }} ({{ tracks|length }})</h2>{% for track in tracks %}{% include 'partials/track_card.html.twig' with {track: track} %}{% else %}<p class="empty">No tracks</p>{% endfor %}</div>{% endfor %}</section></main><footer>Last run: {{ lastRun ? lastRun|date('Y-m-d H:i') : 'Not yet run' }}</footer>{% endblock %}
