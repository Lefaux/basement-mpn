{% extends 'base.html.twig' %}
{% block body %}<header><a href="{{ path('board') }}" class="brand">Music overview</a><nav><a href="{{ path('inconsistencies') }}" class="active">Inconsistencies</a></nav></header><main><h1>Inconsistencies ({{ tracks|length }})</h1><div class="list-controls"><label>Artist <select class="list-filter" data-filter-key="artist"><option value="">All artists</option>{% for value, count in filterArtists %}<option value="{{ value }}">{{ value }} ({{ count }})</option>{% endfor %}</select></label><label>Stage <select class="list-filter" data-filter-key="stage"><option value="">All stages</option>{% for value, count in filterStages %}<option value="{{ value }}">{{ {'idea':'Idea','arrangement':'Arrangement','mastered':'Mastered','final':'Final','release':'Prepped for Release'}[value] }} ({{ count }})</option>{% endfor %}</select></label><label>Legacy folder <select class="list-filter" data-filter-key="root"><option value="">All folders</option>{% for value, count in filterRoots %}<option value="{{ value }}">{{ value }} ({{ count }})</option>{% endfor %}</select></label></div><div class="issue-filters">{% for issue in issueTypes %}<button type="button" data-issue-filter="{{ issue }}">{{ issue }} <b>{{ issueCounts[issue] }}</b></button>{% endfor %}</div><section class="issue-list">{% for track in tracks %}{% include 'partials/track_card.html.twig' with {track: track, filter: filterMeta[track.id]} %}{% else %}<p>Everything is consistent.</p>{% endfor %}</section></main>{% endblock %}
