<article class="track-card" data-track-path="{{ track.path }}" data-preview="{{ track.files.previews|default([])|length > 0 ? 'true' : 'false' }}" data-render="{{ track.files.renders|default([])|length > 0 ? 'true' : 'false' }}" data-landr="{{ track.files.landr|default([])|length > 0 ? 'true' : 'false' }}"{% if filter is defined %} data-artist="{{ filter.artist }}" data-stage="{{ filter.stage }}" data-root="{{ filter.root }}"{% endif %}>
    {% set als = track.files.als|default([]) %}{% set previews = track.files.previews|default([]) %}{% set renders = track.files.renders|default([]) %}{% set landr = track.files.landr|default([]) %}{% set masters = track.files.mstr|default([]) %}
    {% set previewWav = previews|filter(file => file.type == 'wav')|length %}{% set previewMp3 = previews|filter(file => file.type == 'mp3')|length %}{% set renderWav = renders|filter(file => file.type == 'wav')|length %}{% set renderMp3 = renders|filter(file => file.type == 'mp3')|length %}
    {% set landrWav = landr|filter(file => file.type == 'wav')|length %}{% set landrMp3 = landr|filter(file => file.type == 'mp3')|length %}{% set masterWav = masters|filter(file => file.type == 'wav')|length %}{% set masterAif = masters|filter(file => file.type == 'aif')|length %}{% set hasPreview = previews|length > 0 %}{% set hasRender = renders|length > 0 %}{% set hasLandr = landr|length > 0 %}{% set hasMaster = masters|length > 0 %}
    <button class="card-select"><span class="card-identity"><span class="artist">{{ track.artist ?: 'Unknown artist' }}</span><strong>{{ track.title }}</strong></span><table class="file-counts"><tbody><tr class="{{ als|length == 0 ? 'missing' }}"><th>ALS</th><td>{{ als|length }}</td></tr>{% if hasMaster %}{% if masterWav %}<tr><th>MASTER WAV</th><td>{{ masterWav }}</td></tr>{% endif %}{% if masterAif %}<tr><th>MASTER AIF</th><td>{{ masterAif }}</td></tr>{% endif %}{% else %}{% if hasPreview or not hasRender %}<tr class="{{ previewWav == 0 ? 'missing' }}"><th>Preview WAV</th><td>{{ previewWav }}</td></tr><tr class="{{ previewMp3 == 0 ? 'missing' }}"><th>Preview MP3</th><td>{{ previewMp3 }}</td></tr>{% endif %}{% if hasPreview or hasRender %}<tr class="{{ renderWav == 0 ? 'missing' }}"><th>Render WAV</th><td>{{ renderWav }}</td></tr><tr class="{{ renderMp3 == 0 ? 'missing' }}"><th>Render MP3</th><td>{{ renderMp3 }}</td></tr>{% if hasRender or hasLandr %}<tr class="{{ landrWav == 0 ? 'missing' }}"><th>LANDR WAV</th><td>{{ landrWav }}</td></tr><tr class="{{ landrMp3 == 0 ? 'missing' }}"><th>LANDR MP3</th><td>{{ landrMp3 }}</td></tr>{% endif %}{% endif %}{% endif %}</tbody></table>{% if track.issues %}<span class="tags">{% for issue in track.issues %}<i class="issue issue-{{ issue|lower|replace({' ': '-'}) }}">{{ issue }}</i>{% endfor %}</span>{% endif %}</button>
    <aside class="inspector">
        <div class="inspector-head"><div><span class="eyebrow">{{ track.artist ?: 'Unknown artist' }}</span><h3>{{ track.title }}</h3></div><button class="inspector-close" aria-label="Close inspector">×</button></div>
        <div class="inspector-stage">{{ {'idea':'Idea','arrangement':'Arrangement','mastered':'Mastered','final':'Final','release':'Prepped for Release'}[track.stage] }}</div>
        <section><h4>Location</h4><p class="path">{{ track.path }}</p></section>
        <section class="inspector-meta"><div><span>Last changed</span><b>{{ track.driveModifiedAt ? track.driveModifiedAt|date('d M Y, H:i') : 'Unknown' }}</b></div><div><span>Project status</span><b>{{ track.cleanLayout ? 'Clean location' : 'Needs sorting' }}</b></div></section>
        <form method="post" action="{{ path('track_archive', {id: track.id}) }}" onsubmit="return confirm('Move this project to the archive Shared Drive?');"><button class="archive-button">Archive project</button></form>
        {% if track.issues %}<section><h4>Needs attention</h4><div class="inspector-tags">{% for issue in track.issues %}<i class="issue issue-{{ issue|lower|replace({' ': '-'}) }}">{{ issue }}</i>{% endfor %}</div></section>{% endif %}
        <section class="file-inventory"><h4>Detected files</h4>{% for type, files in track.files %}<div class="file-group"><h5>{{ type|replace({'als':'Ableton versions','previews':'Preview renders','renders':'Full renders','landr':'LANDR masters','mstr':'Final masters'})|title }} <span>{{ files|length }}</span></h5>{% for file in files %}<div class="file-row">{% if file.type in ['wav', 'mp3'] %}<a href="#" class="audio-link" data-preview-url="https://drive.google.com/file/d/{{ file.id }}/preview">{{ file.name }}</a>{% else %}<span>{{ file.name }}</span>{% endif %}<small>{{ file.size ? (file.size / 1000000)|number_format(1) ~ ' MB' : '' }}</small></div>{% endfor %}</div>{% else %}<p class="muted">No tracked files found.</p>{% endfor %}</section>
    </aside>
</article>
